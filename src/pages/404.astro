---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到">
  <main class="container" style="padding-top:80px;padding-bottom:100px;text-align:center">
    <h1 style="font-family:var(--font-serif);font-size:64px;margin:0;color:var(--gold);letter-spacing:.1em">404</h1>
    <p style="color:var(--ink-2);font-size:16px;margin:18px 0 30px">你访问的页面不存在或已被移动。</p>
    <a href="/" style="display:inline-block;padding:11px 30px;background:var(--gold);color:#0a0a0a;border-radius:2px;letter-spacing:.12em">返回首页</a>
  </main>
</BaseLayout>
