---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到">
  <main class="container" style="padding-top:80px;padding-bottom:100px;text-align:center">
    <h1 style="font-family:var(--font-serif);font-size:56px;margin:0;color:var(--jade-600)">404</h1>
    <p style="color:var(--ink-2);font-size:17px;margin:16px 0 28px">你访问的页面不存在或已被移动。</p>
    <a href="/" style="display:inline-block;padding:10px 26px;background:var(--jade-600);color:#fff;border-radius:9px">返回首页</a>
  </main>
</BaseLayout>
